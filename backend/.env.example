NODE_ENV=development
PORT=5000

# This module NEVER creates its own Mongo connection in production usage —
# it reuses your existing application's mongoose connection.
# These are only used when running the module's standalone dev/demo server.
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_datagrid_demo

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Redis (optional - leave blank to disable caching)
REDIS_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Max rows allowed in a single export request
EXPORT_MAX_ROWS=50000

# Max page size a client can request
MAX_PAGE_SIZE=500
